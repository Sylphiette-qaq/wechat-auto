# Go build and test output
/bin/
/dist/
*.test
*.out
coverage.out
coverage.html

# Local binaries produced by ad-hoc builds
/wechat-cli
/cmd/wechat-cli/wechat-cli

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# IDE and local assistant metadata
.idea/
.vscode/
.codex/

# Local environment and secrets
.env
.env.*
!.env.example

# Docker/runtime state, logs and diagnostics
/logs/
/diagnostics/
/data/
*.log

# WeChat installation packages are external, proprietary build inputs.
# Keep the explanatory README, but never commit the package itself.
/artifacts/*.deb

# Local AT-SPI test fixtures captured from the live WeChat tree.
# These JSONL files contain real chat content (group/sender names and
# message bodies) and must not be committed. Regenerate them locally
# from a `wechat.sh tree` dump before running scripts/test_parse.py.
/scripts/testdata/

# Local scratch files (live tree dumps, watch output, ad-hoc analysis).
# These also contain real chat content and must not be committed.
/.scratch/

# OS metadata
.DS_Store
Thumbs.db
